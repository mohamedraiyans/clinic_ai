# Copy to deploy/.env ON THE SERVER and fill in. deploy/.env is git-ignored. Never commit it.
# Generate secrets with:  openssl rand -hex 32

# --- where the site lives ---------------------------------------------------------------
# The DNS name of your Azure VM. Caddy gets a free HTTPS certificate for it automatically.
SITE_ADDRESS=your-name.swedencentral.cloudapp.azure.com
PUBLIC_BASE_URL=https://your-name.swedencentral.cloudapp.azure.com
FRONTEND_URL=https://your-name.swedencentral.cloudapp.azure.com
GOOGLE_REDIRECT_URI=https://your-name.swedencentral.cloudapp.azure.com/api/auth/google/callback

# --- database (the db container; not reachable from outside) ----------------------------
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=clinic_ai
DATABASE_URL=postgresql://clinic_user:CHANGE_ME_LONG_RANDOM@db:5432/clinic_ai

# --- security (must be different from your local values) --------------------------------
DEV_LOGIN=0
DISABLE_API_DOCS=1
JWT_SECRET=
SIGNING_SECRET=
ALLOWED_DOCTOR_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers -----------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- only for a production-like test on your own computer (leave out on the server) -----
# HTTP_PORT=8081
# HTTPS_PORT=8444
