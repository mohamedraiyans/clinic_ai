POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=clinic_ai
DATABASE_URL=postgresql://clinic_user:change_me@db:5432/clinic_ai

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HMAC key used to sign prescriptions (generate: openssl rand -hex 32)
SIGNING_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# --- Doctor auth ---
# generate: openssl rand -hex 32
JWT_SECRET=
# Only these Google accounts may sign in (comma-separated)
ALLOWED_DOCTOR_EMAILS=you@example.com
FRONTEND_URL=http://localhost:5173
# Create an OAuth client (Web application) in Google Cloud Console; add the redirect URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# LOCAL TESTING ONLY: lets allowlisted emails sign in without Google. Must be 0 in production.
DEV_LOGIN=0
